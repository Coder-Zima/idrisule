---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

export const prerender = false;

const allPosts = await getCollection('blog');
const sortedPosts = [...allPosts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestPost = sortedPosts[0] ?? null;
const quotePost = allPosts.length > 0 ? allPosts[Math.floor(Math.random() * allPosts.length)] : null;
const quoteText = quotePost
	? (quotePost.body || quotePost.data.description || '')
		.replace(/[#>*_`\[\]()]/g, '')
		.replace(/\s+/g, ' ')
		.trim()
		.slice(0, 180)
	: 'Writing is a way to think clearly and share what matters.';
	const posts = sortedPosts
	.slice(1)
	.map((post) => ({
		...post,
		preview:
			(post.body || post.data.description || '')
				.replace(/[#>*_`\[\]()]/g, '')
				.replace(/\s+/g, ' ')
				.trim()
				.slice(0, 140),
	}));
---


<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="home-shell">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span class="status-dot"></span> A personal corner of the internet</p>
					<h1 id="hero-title">Hello, I’m <span>Idris Sule.</span></h1>
					<p class="intro">
						Welcome in. This is where I share ideas, things I’m learning, and the occasional
						curiosity that deserves a closer look. Make yourself at home.
					</p>
					<div class="hero-links" id="contact">
						<a class="primary-link" href="/blog/">Explore the blog <span aria-hidden="true">&rarr;</span></a>
						<nav class="social-links" id="socials" aria-label="Social media">
							<a href="https://www.linkedin.com/in/idris-sule-umar-a7259a157/?isSelfProfile=false" target="_blank" rel="noreferrer">LinkedIn</a>
							<a href="https://x.com/idrisule" target="_blank" rel="noreferrer">X</a>
						</nav>
					</div>
				</div>
				<div class="avatar-panel" role="img" aria-label="Avatar placeholder for Idrisule">
					<div class="avatar-mark" aria-hidden="true">I</div>
					<p>Portrait coming soon</p>
				</div>
			</section>

			{latestPost && (
				<section class="featured-section" aria-labelledby="latest-title">
					<div class="featured-card">
						<a class="featured-image-link" href={`/blog/${latestPost.id}/`}>
							<Image
								src={latestPost.data.heroImage ?? FallbackImage}
								alt={latestPost.data.title}
								width={720}
								height={450}
								class="featured-image"
							/>
						</a>
						<div class="featured-copy">
							<p class="featured-badge">LATEST</p>
							<h2 id="latest-title" class="featured-title font-serif">{latestPost.data.title}</h2>
							<p class="featured-date"><FormattedDate date={latestPost.data.pubDate} /></p>
							<p class="featured-description">{latestPost.data.description}</p>
							<a class="read-post" href={`/blog/${latestPost.id}/`}>Read Post <span aria-hidden="true">&rarr;</span></a>
						</div>
					</div>
				</section>
			)}

			{quotePost && (
				<section class="quote-section" aria-labelledby="quote-title">
					<div class="quote-shell">
						<p class="eyebrow quote-label">QUOTE OF THE DAY</p>
						<blockquote class="quote-panel">
							<span
								class="quote-text font-serif text-theme-text text-3xl italic leading-relaxed md:text-4xl"
								data-typewriter
								data-text={quoteText}
							>{quoteText}</span>
						</blockquote>
						<p id="quote-title" class="quote-attribution">— {quotePost.data.title}</p>
					</div>
				</section>
			)}

			<section class="latest" aria-labelledby="latest-title">
				<div class="section-heading">
					<div>
						<p class="eyebrow">NOTES, IDEAS & CURIOSITIES</p>
						<h2 id="latest-title">More from the blog</h2>
					</div>
					<a class="all-posts" href="/blog/">All posts <span aria-hidden="true">&rarr;</span></a>
				</div>
				{posts.length > 0 ? (
					<div class="post-list">
						{posts.map((post, index) => (
							<a class="post-row" href={`/blog/${post.id}/`}>
								<span class="post-number">0{index + 1}</span>
								<span class="post-copy">
									<span class="post-title">{post.data.title}</span><span class="post-description">{post.preview}</span>
								</span>
								<time class="post-date"><FormattedDate date={post.data.pubDate} /></time>
								<span class="post-arrow" aria-hidden="true">&rarr;</span>
							</a>
						))}
					</div>
				) : (
					<p class="empty-state">New writing is on the way.</p>
				)}
			</section>

	</div>

	<script>
		const typewriterTargets = document.querySelectorAll('[data-typewriter]');

		const typewriter = (element: HTMLElement) => {
			if (!element || element.dataset.typed === 'true') return;
			element.dataset.typed = 'true';
			const fullText = element.dataset.text || element.textContent || '';
			element.textContent = '';
			let index = 0;

			const tick = () => {
				if (index <= fullText.length) {
					element.textContent = fullText.slice(0, index);
					index += 1;
					setTimeout(tick, 22);
				}
			};

			tick();
		};

		const observer = new IntersectionObserver(
			(entries, currentObserver) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting && entry.target instanceof HTMLElement) {
						typewriter(entry.target);
						currentObserver.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.35 }
		);

		typewriterTargets.forEach((element) => observer.observe(element));
	</script>
</BaseLayout>

<style>
	:global(body) {
		background: #fff;
		background-size: auto;
		color: #595959;
		font-size: 17px;
	}

	.home-shell {
		width: 100%;
		max-width: none;
		padding: 0;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(250px, 0.65fr);
		align-items: center;
		gap: 5rem;
		padding: 5.5rem 0 5rem;
		border-bottom: 1px solid #dce4dc;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0 0 1.25rem;
		color: #006D5B;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.status-dot {
		width: 8px;
		aspect-ratio: 1;
		border-radius: 50%;
		background: #df7659;
	}

	.hero h1 {
		max-width: 650px;
		margin-bottom: 1.15rem;
		font-size: 3.7rem;
		font-weight: 700;
		letter-spacing: 0;
		line-height: 1.08;
	}

	.hero h1 span {
		color: #006D5B;
	}

	.intro {
		max-width: 560px;
		margin: 0;
		color: #006D5B;
		font-size: 1.1rem;
		line-height: 1.75;
	}

	.hero-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.5rem;
		margin-top: 2rem;
	}

	.featured-section {
		padding: 3rem 0 0;
	}

	.featured-card {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		align-items: center;
		gap: 2.25rem;
		padding: 1rem;
		border: 1px solid #00000021;
		border-radius: 10px;
	}

	.featured-image-link {
		display: block;
		min-width: 0;
	}

	.featured-image {
		display: block;
		width: 100%;
		aspect-ratio: 8 / 5;
		border-radius: 10px;
		object-fit: cover;
	}

	.featured-copy {
		padding: 1.25rem 1.25rem 1.25rem 0;
	}

	.featured-badge {
		display: inline-block;
		margin: 0 0 1rem;
		padding: 0.35rem 0.55rem;
		border-radius: 2px;
		background: #006D5B;
		color: #fff;
		font-family: 'Quattrocento Sans', sans-serif;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.featured-title {
		margin: 0;
		color: #252525;
		font-size: 2.25rem;
		font-weight: 400;
		line-height: 1.15;
	}

	.featured-date {
		margin: 0.75rem 0 0;
		color: #595959;
		font-family: 'Quattrocento Sans', sans-serif;
		font-size: 0.82rem;
	}

	.featured-description {
		margin: 1rem 0 1.25rem;
		color: #595959;
		font-size: 1rem;
		line-height: 1.65;
	}

	.read-post {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		color: #006D5B;
		font-family: 'Quattrocento Sans', sans-serif;
		font-size: 0.88rem;
		font-weight: 700;
		text-decoration: none;
	}

	.read-post:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.primary-link {
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		min-height: 48px;
		padding: 0.65rem 1.05rem;
		border: 1px solid #000;
		border-radius: 4px;
		background: transparent;
		color: #000;
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		transition: background 160ms ease, transform 160ms ease;
	}

	.primary-link:hover {
		transform: translateY(-2px);
		background: #f4f4f4;
		color: #000;
	}

	.social-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.social-links a,
	.all-posts {
		color: #006D5B;
		font-size: 0.85rem;
		font-weight: 700;
		text-decoration-color: #a9b8ab;
		text-underline-offset: 4px;
	}

	.social-links a:hover,
	.all-posts:hover {
		color: #c35f43;
	}

	.avatar-panel {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 310px;
		overflow: hidden;
		border-radius: 6px;
		background-color: #006D5B;
		background-image: radial-gradient(rgba(255, 255, 255, 0.12) 1px, transparent 1px);
		background-size: 18px 18px;
	}

	.avatar-mark {
		display: grid;
		place-items: center;
		width: 146px;
		aspect-ratio: 1;
		border: 1px solid rgba(255, 255, 255, 0.5);
		border-radius: 50%;
		background: #dbeafe;
		color: #006D5B;
		font-size: 4.5rem;
		font-weight: 700;
		line-height: 1;
	}

	.avatar-panel p {
		position: absolute;
		bottom: 1rem;
		left: 1.25rem;
		margin: 0;
		color: rgba(255, 255, 255, 0.8);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.quote-section {
		padding: 3rem 0 1rem;
	}

	.quote-shell {
		padding: 2rem 0;
		border-top: 1px solid #dce4dc;
		border-bottom: 1px solid #dce4dc;
	}

	.quote-label {
		margin-bottom: 1rem;
	}

	.quote-panel {
		margin: 0;
	}

	.quote-text {
		display: inline-block;
		max-width: 100%;
		color: #5a5a5a;
		font-style: italic;
		letter-spacing: -0.02em;
		white-space: normal;
	}

	.quote-attribution {
		margin: 1rem 0 0;
		color: #5a5a5a;
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.latest {
		padding: 3.5rem 0 5rem;
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.section-heading .eyebrow {
		margin-bottom: 0.65rem;
	}

	.section-heading h2 {
		margin: 0;
		font-size: 1.85rem;
		letter-spacing: 0;
	}

	.all-posts {
		margin-bottom: 0.35rem;
		white-space: nowrap;
	}

	.post-list {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}

	.post-row {
		display: grid;
		grid-template-columns: 42px minmax(0, 1fr) auto 22px;
		align-items: center;
		gap: 1rem;
		width: 100%;
		min-height: 102px;
		padding: 1rem 0;
		border: 0;
		border-bottom: 1px solid #00000021;
		border-radius: 0;
		color: inherit;
		text-decoration: none;
		transition: padding 160ms ease, background 160ms ease;
	}

	.post-row:hover {
		padding-right: 0;
		padding-left: 0;
		background: rgba(255, 255, 255, 0.55);
	}

	.post-number {
		color: #c35f43;
		font-size: 0.78rem;
		font-weight: 700;
	}

	.post-copy {
		display: grid;
		gap: 0.25rem;
		min-width: 0;
	}

	.post-title {
		color: #006D5B;
		font-size: 1.1rem;
		font-weight: 700;
		line-height: 1.35;
	}

	.post-description {
		display: -webkit-box;
		overflow: hidden;
		color: #006D5B;
		font-size: 0.86rem;
		line-height: 1.5;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 1;
	}

	.post-date {
		color: #006D5B;
		font-size: 0.78rem;
		white-space: nowrap;
	}

	.post-arrow {
		color: #006D5B;
		font-size: 1rem;
		text-align: right;
	}

	.empty-state {
		padding: 1.5rem 0;
		color: #006D5B;
	}

	@media (max-width: 720px) {
		.home-shell {
			width: min(100% - 2rem, 540px);
		}

		.hero {
			grid-template-columns: 1fr;
			gap: 2.5rem;
			padding: 3.5rem 0 3rem;
		}

		.featured-section {
			padding-top: 2rem;
		}

		.featured-card {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}

		.featured-copy {
			padding: 1rem 0.5rem 0.5rem;
		}

		.featured-title {
			font-size: 1.85rem;
		}

		.hero h1 {
			font-size: 2.65rem;
		}

		.intro {
			font-size: 1rem;
		}

		.avatar-panel {
			min-height: 250px;
		}

		.avatar-mark {
			width: 120px;
			font-size: 3.6rem;
		}

		.latest {
			padding: 2.75rem 0 3.5rem;
		}

		.post-row {
			grid-template-columns: 28px minmax(0, 1fr) 18px;
			gap: 0.6rem;
			padding: 1rem;
		}

		.post-list {
			grid-template-columns: 1fr;
		}

		.post-date {
			grid-column: 2;
			grid-row: 2;
		}

		.post-arrow {
			grid-column: 3;
			grid-row: 1 / span 2;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.primary-link,
		.post-row {
			transition: none;
		}
	}
</style>


