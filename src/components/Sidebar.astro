<div class="flex flex-col items-start">
	<img
		src="/idris-avatar.svg"
		alt="IS monogram avatar placeholder for Idris Sule"
		width="80"
		height="80"
		class="mb-7 h-20 w-20 rounded-[10px] object-cover"
	/>
	<h1 class="mb-4 text-5xl font-normal leading-[0.98] text-theme-heading">Idris Sule</h1>
	<p class="m-0 max-w-xs text-base leading-7 text-theme-text">
		Writer and curious observer, collecting thoughts on creative work and the details worth noticing.
	</p>
	<nav aria-label="Sidebar navigation" class="mt-9 flex flex-col items-start gap-4 font-sans">
		<a
			href="/#contact"
			class="text-xs font-bold uppercase tracking-widest text-theme-heading no-underline transition-colors hover:text-theme-text"
		>
			Contact
		</a>
		<a
			href="/#socials"
			class="text-xs font-bold uppercase tracking-widest text-theme-heading no-underline transition-colors hover:text-theme-text"
		>
			Socials
		</a>
	</nav>
</div>