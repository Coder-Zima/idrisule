---
---

<div class="flex flex-col items-start">
	<img
		src="/idris-avatar.svg"
		alt="IS monogram avatar placeholder for Idris Sule"
		width="80"
		height="80"
		class="mb-7 h-20 w-20 rounded-[10px] object-cover"
	/>
	<h1 class="mb-4 font-serif text-5xl font-normal leading-[0.98] text-theme-heading">Idris Sule</h1>
	<p class="m-0 max-w-xs text-base leading-7 text-theme-text">
		Writer and curious observer, collecting thoughts on creative work and the details worth noticing.
	</p>
	<button type="button" class="theme-toggle mt-7" data-theme-toggle aria-label="Switch to dark mode" title="Switch to dark mode">
		<svg class="theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
			<path d="M20.9 13A8.5 8.5 0 0 1 11 3.1 8.5 8.5 0 1 0 20.9 13Z" />
		</svg>
		<svg class="theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
			<circle cx="12" cy="12" r="4" />
			<path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
		</svg>
	</button>
</div>