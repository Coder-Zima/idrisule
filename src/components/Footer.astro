			<span class="sr-only">Visit Idris Sule on LinkedIn</span>
			<svg viewBox="0 0 24 24" aria-hidden="true" width="28" height="28">
				<path fill="currentColor" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zM8 19H5V8h3v11zM6.5 6.732c-.966 0-1.75-.79-1.75-1.764S5.534 3.204 6.5 3.204s1.75.79 1.75 1.764-.783 1.764-1.75 1.764zM20 19h-3v-5.604c0-3.368-4-3.113-4 0V19h-3V8h3v1.765c1.396-2.586 7-2.777 7 2.476V19z" />
			</svg>
		</a>
		<a href="https://x.com/idrisule" target="_blank" rel="noreferrer">
			<span class="sr-only">Visit Idris Sule on X</span>
			<svg viewBox="0 0 24 24" aria-hidden="true" width="28" height="28">
				<path fill="currentColor" d="M18.901 1.153h3.68l-8.04 9.19L24 22.847h-7.406l-5.8-7.584-6.636 7.584H.474l8.6-9.83L0 1.153h7.594l5.243 6.932 6.064-6.932zm-1.29 19.49h2.039L6.486 3.24H4.298l13.313 17.403z" />
